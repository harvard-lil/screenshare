# see http://django-environ.readthedocs.io/ for formats for this file.

# required for dev or prod:
SECRET_KEY=

# required by the slack_socket_mode process:
SLACK_APP_TOKEN=
SLACK_BOT_ACCESS_TOKEN=

# optional
POST_CHANNEL=
ASCII_FIRE_URL=
# AMBIENT_YOUTUBE_VIDEO_<n>='["emoji", {"youtube_id": "..."}]'
PRIMITIVE_URL=
EGRESS_PROXY_URL=

# for dev:
DEBUG=on
ALLOWED_HOSTS=*

# for prod:
DEBUG=off
ALLOWED_HOSTS=example1.com,example2.com
LOGLEVEL=INFO
